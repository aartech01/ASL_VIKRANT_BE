PORT=4000

# MongoDB Atlas connection string (includes the database name at the end of the path)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/family_tree_db?retryWrites=true&w=majority&appName=Cluster0

# Cloudinary (used to store site photographs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated list of origins allowed to call this API.
# Add your GitHub Pages URL and, for local testing, http://localhost:5500 (or whatever port you use).
ALLOWED_ORIGINS=https://aartech01.github.io,http://localhost:5500

# Shared secret required (as the x-admin-key header) to make any change through the API.
# Anyone without it can only read (GET) — set your own value here and in your host's env vars.
ADMIN_KEY=change_me_to_a_long_random_value
